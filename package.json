{
  "name": "@mattplays/mpds",
  "version": "0.1.0",
  "description": "Matt's Personal Design System — design tokens and iconography as CSS custom properties",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.css",
  "exports": {
    ".": "./dist/index.css",
    "./css/*": "./dist/css/*",
    "./icons": {
      "types": "./dist/icons/index.d.ts",
      "import": "./dist/icons/index.mjs"
    }
  },
  "scripts": {
    "build": "npm run build:tokens && npm run build:icons",
    "build:tokens": "tsx scripts/build-tokens.ts",
    "build:icons": "tsx scripts/build-icons.ts",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "central-icons": "*",
    "react": ">=16.6.0 <20"
  },
  "peerDependenciesMeta": {
    "central-icons": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
